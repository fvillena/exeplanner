# Backend ejecutado directamente en Windows/macOS/Linux.
MONGODB_DB=exeplanner
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Acceso a /admin. Configura ambos valores; sin ellos el acceso queda deshabilitado.
# Usa una contrasena larga y unica. No se exponen al frontend.
# En Compose, pasar ambas variables al entorno del servicio backend.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Docker deployment public origin. Use the complete HTTPS domain in production.
APP_ORIGIN=https://planner.example.com

# Si el backend se ejecuta dentro de un servicio Docker en la misma red,
# usa esta URI en lugar de la anterior:
# MONGODB_URI=mongodb://root:Gatos@mongo:27017/exeplanner?authSource=admin
